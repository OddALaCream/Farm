# =====================================
# CONFIGURACIÓN DEL BOT DE ARBITRAJE P2P
# =====================================

# --- Tipo de cambio ---
# Costo de 1 USD en BOB (tipo de cambio oficial/paralelo)
USD_BOB_COST=11.10

# --- Comisiones Skrill ---
# Comisión de depósito Skrill (5% = 0.05)
SKRILL_DEPOSIT_FEE=0.05

# Comisión de transferencia Skrill (1.45% = 0.0145)
SKRILL_TRANSFER_FEE=0.0145

# --- Parámetros de monitoreo ---
# Margen mínimo para enviar alerta (en %)
MIN_PROFIT_PERCENT=5

# Capital disponible en BOB
CAPITAL_BOB=10000

# Intervalo entre verificaciones (en segundos)
CHECK_INTERVAL_SECONDS=60

# --- WhatsApp ---
# Número de teléfono con código de país (sin + ni espacios)
WHATSAPP_NUMBER=591XXXXXXXX

# --- General ---
# Zona horaria
TIMEZONE=America/La_Paz

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
